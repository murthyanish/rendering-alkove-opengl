#version 430 core

layout (local_size_x = 1, local_size_y = 16) in;

// images
layout(rgba32f, binding = 0) readonly uniform image2D imgInput;
layout(rgba32f, binding = 1) writeonly uniform image2D imgOutput;

// Gaussian kernel coefficients (example for 5x5 kernel)
const float kernel[5] = {0.0517, 0.1355, 0.2215, 0.1355, 0.0517};

uniform float alpha;

void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);

    vec4 sum = vec4(0);
    float weightSum = 0.0;

    for (int i = 0; i < 5; ++i) {
      sum +=  kernel[i] * imageLoad(imgInput, texelCoord+ivec2(0, i-2));
      weightSum += kernel[i];
    }

    imageStore(imgOutput, texelCoord, sum/weightSum);
}