#version 430 core

layout (local_size_x = 16, local_size_y = 1) in;

// images
layout(rgba32f, binding = 0) readonly uniform image2D imgInput;
layout(rgba32f, binding = 1) writeonly uniform image2D imgOutput;

layout(std140, binding = 3) uniform moments {
  float width;
  float weights[101];
};

uniform float alpha;

void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);

    vec4 sum = vec4(0);
    float weightSum = 0.0;
     
    for (int i = 0; i < 2*width+1; ++i) {
      sum +=  weights[i] * imageLoad(imgInput, texelCoord+ivec2(i-2, 0));
      //sum +=  imageLoad(imgInput, texelCoord+ivec2(i-2, 0));
      weightSum += weights[i];
      //weightSum += 1;
    }

    imageStore(imgOutput, texelCoord, sum/weightSum);
}